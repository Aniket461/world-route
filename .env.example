MAPBOX_ACCESS_TOKEN=pk.your_public_token_here
PORT=8080

# Comma-separated browser origins allowed to call the API.
# Local Angular + Netlify (replace with your real Netlify URL after first deploy).
CORS_ORIGIN=http://localhost:4200,https://YOUR_SITE.netlify.app

# Used only on Netlify builds (frontend → Railway API).
# API_BASE_URL=https://YOUR_SERVICE.up.railway.app
