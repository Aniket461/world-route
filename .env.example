MAPBOX_ACCESS_TOKEN=pk.your_public_token_here
PORT=8080

# Comma-separated browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:4200,https://YOUR_SITE.netlify.app

# Postgres (local docker compose defaults).
DATABASE_URL=postgres://worldroute:worldroute@localhost:5432/worldroute?sslmode=disable

# Sign JWTs for auth (use a long random string in production).
JWT_SECRET=dev-change-me-world-route

# Used only on Netlify builds (frontend → Railway API).
# API_BASE_URL=https://YOUR_SERVICE.up.railway.app
